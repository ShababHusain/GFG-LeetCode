class Solution {
    int getCount(String s, int k) {
        int[] groupCounts = new int[26];
        int n = s.length();
        int i = 0;
        
        // Traverse the string to find all contiguous groups
        while (i < n) {
            char c = s.charAt(i);
            int j = i;
            while (j < n && s.charAt(j) == c) {
                j++;
            }
            // A group for character 'c' is completed
            groupCounts[c - 'a']++;
            i = j; // Move to the next distinct character block
        }
        
        // Count characters that appear in exactly k groups
        int distinctChars = 0;
        for (int count : groupCounts) {
            if (count == k) {
                distinctChars++;
            }
        }
        
        return distinctChars;
    }
}
