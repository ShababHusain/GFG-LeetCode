class Solution {
    public int minFlips(String s) {
        int n = s.length();
        int flipsStartZero = 0;

        for (int i = 0; i < n; i++) {
            char expected = (i % 2 == 0) ? '0' : '1';
            if (s.charAt(i) != expected) {
                flipsStartZero++;
            }
        }

        int flipsStartOne = n - flipsStartZero;
        return Math.min(flipsStartZero, flipsStartOne);
    }
}
