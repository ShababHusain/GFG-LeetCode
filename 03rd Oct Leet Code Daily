class Solution {
    public int longestValidParentheses(String s) {
        int n = s.length();
        int maxLen = 0;

        // Array stack for optimal execution speed
        int[] stack = new int[n + 1];
        int top = 0;
        stack[top] = -1; // Initial base index boundary

        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '(') {
                stack[++top] = i;
            } else {
                top--;
                if (top < 0) {
                    // Reset boundary index when stack becomes empty
                    stack[++top] = i;
                } else {
                    maxLen = Math.max(maxLen, i - stack[top]);
                }
            }
        }

        return maxLen;
    }
}
