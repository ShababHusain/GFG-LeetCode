class Solution {
    public int pairCount(int x, int y) {
        // LCM must be divisible by GCD
        if (y % x != 0) {
            return 0;
        }
        
        int n = y / x;
        int res = 0;
        
        // Find factor pairs (i, n/i) of n up to sqrt(n)
        for (int i = 1; i <= Math.sqrt(n); i++) {
            if (n % i == 0) {
                // Check if the factor pair is coprime
                if (gcd(i, n / i) == 1) {
                    // If i == n / i, we add 1, otherwise 2 (for both (a,b) and (b,a) orders)
                    if (i == n / i) {
                        res += 1;
                    } else {
                        res += 2;
                    }
                }
            }
        }
        
        return res;
    }
    
    private int gcd(int a, int b) {
        if (b == 0) {
            return a;
        }
        return gcd(b, a % b);
    }
}
