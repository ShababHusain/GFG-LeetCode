import java.util.*;

class Solution {
    private List<Integer>[] origAdj;
    private List<Integer>[] newAdj;
    private int[] parent;
    private String s;
    private int[] lastSeen;
    private int[] ans;

    public int[] findSubtreeSizes(int[] parent, String s) {
        int n = parent.length;
        this.parent = parent;
        this.s = s;
        this.origAdj = new ArrayList[n];
        this.newAdj = new ArrayList[n];
        this.lastSeen = new int[26];
        this.ans = new int[n];

        Arrays.fill(lastSeen, -1);
        for (int i = 0; i < n; i++) {
            origAdj[i] = new ArrayList<>();
            newAdj[i] = new ArrayList<>();
        }
        for (int i = 1; i < n; i++) {
            origAdj[parent[i]].add(i);
        }

        dfsRewire(0);
        dfsSize(0);
        return ans;
    }

    private void dfsRewire(int u) {
        int c = s.charAt(u) - 'a';
        if (u != 0) {
            int newParent = (lastSeen[c] != -1) ? lastSeen[c] : parent[u];
            newAdj[newParent].add(u);
        }

        int prev = lastSeen[c];
        lastSeen[c] = u;

        for (int v : origAdj[u]) {
            dfsRewire(v);
        }

        lastSeen[c] = prev;
    }

    private int dfsSize(int u) {
        int total = 1;
        for (int v : newAdj[u]) {
            total += dfsSize(v);
        }
        ans[u] = total;
        return total;
    }
}
