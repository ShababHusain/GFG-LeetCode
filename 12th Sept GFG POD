class Solution {
    public long maxProduct(int[] arr, int k) {
        int n = arr.length;
        Arrays.sort(arr);

        long ans = 1;
        int i = 0;
        int j = n - 1;

        // Case where k is odd and all elements are non-positive
        if (k % 2 != 0 && arr[n - 1] <= 0) {
            for (int idx = n - 1; idx >= n - k; idx--) {
                ans *= arr[idx];
            }
            return ans;
        }

        // If k is odd, take the largest element first to make k even
        if (k % 2 != 0) {
            ans *= arr[j];
            j--;
            k--;
        }

        // Process remaining k in pairs from both ends
        while (k > 0) {
            long leftProduct = (long) arr[i] * arr[i + 1];
            long rightProduct = (long) arr[j] * arr[j - 1];

            if (leftProduct > rightProduct) {
                ans *= leftProduct;
                i += 2;
            } else {
                ans *= rightProduct;
                j -= 2;
            }
            k -= 2;
        }

        return ans;
    }
}
