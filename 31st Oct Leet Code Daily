class Solution {
    public int uniquePaths(int[][] grid) {
        int MOD = 1_000_000_007;
        int m = grid.length;
        int n = grid[0].length;
        
        long[][] dp = new long[n + 1][2];
        dp[1][0] = 1;
        dp[1][1] = 1;
        
        for (int r = 0; r < m; r++) {
            for (int c = 0; c < n; c++) {
                int j = c + 1;
                if (grid[r][c] == 1) {
                    long fromTop = dp[j][1];
                    long fromLeft = dp[j - 1][0];
                    dp[j][0] = fromTop;
                    dp[j][1] = fromLeft;
                } else {
                    long ways = (dp[j][1] + dp[j - 1][0]) % MOD;
                    dp[j][0] = ways;
                    dp[j][1] = ways;
                }
            }
        }
        
        return (int) dp[n][0];
    }
}
