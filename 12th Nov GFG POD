/* Structure of a Binary Search Tree node
class Node {
    int data;
    Node left, right;

    public Node(int val) {
        data = val;
        left = right = null;
    }
}
*/

class Solution {
    public int minDiff(Node root, int k) {
        int minDiff = Integer.MAX_VALUE;
        Node curr = root;
        
        while (curr != null) {
            int diff = Math.abs(curr.data - k);
            minDiff = Math.min(minDiff, diff);
            
            if (diff == 0) {
                return 0; // Exact match found
            }
            
            if (k < curr.data) {
                curr = curr.left;
            } else {
                curr = curr.right;
            }
        }
        
        return minDiff;
    }
}
