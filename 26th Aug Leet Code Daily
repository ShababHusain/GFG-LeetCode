class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        int n = s.length();
        // Find minimum length of substring with exactly k ones
        int l = 0, ones = 0;
        int minLen = Integer.MAX_VALUE;
        for (int r = 0; r < n; ++r) {
            if (s.charAt(r) == '1') ones++;
            while (ones == k && l <= r) {
                minLen = Math.min(minLen, r - l + 1);
                if (s.charAt(l) == '1') ones--;
                l++;
            }
        }

        if (minLen == Integer.MAX_VALUE) return "";

        // Find lexicographically smallest substring of length minLen with exactly k ones
        String best = null;
        int curOnes = 0;
        // initial window
        for (int i = 0; i < minLen; ++i) {
            if (s.charAt(i) == '1') curOnes++;
        }
        if (curOnes == k) best = s.substring(0, minLen);

        for (int start = 1; start + minLen <= n; ++start) {
            if (s.charAt(start - 1) == '1') curOnes--;
            if (s.charAt(start + minLen - 1) == '1') curOnes++;
            if (curOnes == k) {
                String cand = s.substring(start, start + minLen);
                if (best == null || cand.compareTo(best) < 0) best = cand;
            }
        }

        return best == null ? "" : best;
    }
}
