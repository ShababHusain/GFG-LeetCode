class Solution {
    public int minMoves(int[] arr) {
        int n = arr.length;
        if (n <= 1) return 0;

        int[] pos = new int[n + 1]; // pos[val] = index of val in arr
        for (int i = 0; i < n; ++i) pos[arr[i]] = i;

        int best = 1;
        int cur = 1;
        for (int v = 2; v <= n; ++v) {
            if (pos[v] > pos[v - 1]) {
                cur++;
            } else {
                cur = 1;
            }
            if (cur > best) best = cur;
        }
        return n - best;
    }
}
