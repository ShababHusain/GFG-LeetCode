class Solution {
    public int minMoves(String[] classroom, int energy) {
        int m = classroom.length;
        int n = classroom[0].length();
        int startR = -1, startC = -1;
        
        int[][] litterIndex = new int[m][n];
        for (int i = 0; i < m; i++) {
            Arrays.fill(litterIndex[i], -1);
        }
        
        int k = 0; 
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                char c = classroom[i].charAt(j);
                if (c == 'S') {
                    startR = i;
                    startC = j;
                } else if (c == 'L') {
                    litterIndex[i][j] = k++;
                }
            }
        }
        
        if (k == 0) return 0;
        
        int targetMask = (1 << k) - 1;
        
        int[][][] maxE = new int[m][n][1 << k];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                Arrays.fill(maxE[i][j], -1);
            }
        }
        
        Queue<int[]> q = new LinkedList<>();
        q.offer(new int[]{startR, startC, 0, energy});
        maxE[startR][startC][0] = energy;
        
        int moves = 0;
        int[][] dirs = {{0, 1}, {1, 0}, {0, -1}, {-1, 0}};
        
        while (!q.isEmpty()) {
            int size = q.size();
            
            for (int i = 0; i < size; i++) {
                int[] curr = q.poll();
                int r = curr[0], c = curr[1], mask = curr[2], e = curr[3];
                
                if (e == 0) continue;
                
                for (int[] d : dirs) {
                    int nr = r + d[0];
                    int nc = c + d[1];
                    
                    if (nr >= 0 && nr < m && nc >= 0 && nc < n) {
                        char nextChar = classroom[nr].charAt(nc);
                        
                        if (nextChar == 'X') continue;
                        
                        int ne = e - 1;
                        if (nextChar == 'R') {
                            ne = energy; 
                        }
                        
                        int nmask = mask;
                        if (litterIndex[nr][nc] != -1) {
                            nmask |= (1 << litterIndex[nr][nc]);
                        }
                        
                        if (nmask == targetMask) {
                            return moves + 1;
                        }
                        
                        if (ne > maxE[nr][nc][nmask]) {
                            maxE[nr][nc][nmask] = ne;
                            q.offer(new int[]{nr, nc, nmask, ne});
                        }
                    }
                }
            }
            moves++;
        }
        
        return -1;
    }
}
