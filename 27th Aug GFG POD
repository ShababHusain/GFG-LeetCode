class Solution {
    public int maxArea(int[][] mat) {
        int n = mat.length, m = mat[0].length;
        int[][] h = new int[n][m];

        for (int j = 0; j < m; j++) {
            h[0][j] = mat[0][j];
            for (int i = 1; i < n; i++) {
                h[i][j] = mat[i][j] == 0 ? 0 : h[i - 1][j] + 1;
            }
        }

        int ans = 0;

        for (int i = 0; i < n; i++) {
            int[] cnt = new int[n + 1];
            for (int j = 0; j < m; j++) {
                cnt[h[i][j]]++;
            }

            int col = 0;
            for (int height = n; height >= 0; height--) {
                while (cnt[height]-- > 0) {
                    h[i][col++] = height;
                }
            }

            for (int j = 0; j < m; j++) {
                ans = Math.max(ans, h[i][j] * (j + 1));
            }
        }

        return ans;
    }
}
