/* Structure of Binary Tree Node
class Node {
    int data;
    Node left, right;

    Node(int val) {
        data = val;
        left = right = null;
    }
} */


class Solution {
    int preIndex = 0;
    Map<Integer, Integer> mirrorIndexMap;

    public Node constructBinaryTree(int[] pre, int[] preMirror) {
        int n = pre.length;
        mirrorIndexMap = new HashMap<>();
        
        // Store indices of elements in preMirror for O(1) lookup
        for (int i = 0; i < n; i++) {
            mirrorIndexMap.put(preMirror[i], i);
        }
        
        return build(pre, preMirror, 0, n - 1, n);
    }

    private Node build(int[] pre, int[] preMirror, int l, int r, int n) {
        if (preIndex >= n || l > r) return null;

        Node root = new Node(pre[preIndex++]);

        // Leaf node
        if (l == r || preIndex >= n) return root;

        // Find index of next element of pre[] in preMirror[]
        int idx = mirrorIndexMap.get(pre[preIndex]);

        // Build left and right subtrees
        root.left = build(pre, preMirror, idx, r, n);
        root.right = build(pre, preMirror, l + 1, idx - 1, n);

        return root;
    }
}
