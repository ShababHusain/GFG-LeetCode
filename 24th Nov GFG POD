import java.util.*;

class Solution {
    public ArrayList<Integer> findPairs(int arr[]) {
        int n = arr.length;
        Map<Integer, List<int[]>> pairMap = new HashMap<>();

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int sum = arr[i] + arr[j];
                pairMap.computeIfAbsent(sum, k -> new ArrayList<>()).add(new int[]{i, j});
            }
        }

        for (int a = 0; a < n; a++) {
            for (int b = a + 1; b < n; b++) {
                int sum = arr[a] + arr[b];
                List<int[]> candidates = pairMap.get(sum);
                if (candidates == null) continue;

                for (int[] p : candidates) {
                    int c = p[0], d = p[1];
                    if (c != a && c != b && d != a && d != b) {
                        if (a < c || (a == c && b < d)) {
                            return new ArrayList<>(Arrays.asList(a, b, c, d));
                        }
                    }
                }
            }
        }

        return new ArrayList<>(Arrays.asList(-1, -1, -1, -1));
    }
}
