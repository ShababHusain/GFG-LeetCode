import java.util.HashSet;

class Solution {
    public boolean checkWithinK(int[] arr, int k) {
        HashSet<Integer> window = new HashSet<>();
        
        for (int i = 0; i < arr.length; i++) {
            // If the element is already in the window, a duplicate within distance k exists
            if (window.contains(arr[i])) {
                return true;
            }
            
            window.add(arr[i]);
            
            // Maintain the window size to at most k
            if (i >= k) {
                window.remove(arr[i - k]);
            }
        }
        
        return false;
    }
}
