class Solution {
    static class Node {
        char leftChar, rightChar;
        int leftCount, rightCount, maxCount;
    }

    private Node[] segTree;
    private char[] arr;
    private int n;

    public int[] longestRepeating(String s, String queryCharacters, int[] queryIndices) {
        n = s.length();
        arr = s.toCharArray();
        segTree = new Node[4 * n];
        build(1, 0, n - 1);

        int k = queryIndices.length;
        int[] res = new int[k];
        for (int i = 0; i < k; i++) {
            update(1, 0, n - 1, queryIndices[i], queryCharacters.charAt(i));
            res[i] = segTree[1].maxCount; // root stores global max
        }
        return res;
    }

    private void build(int idx, int l, int r) {
        segTree[idx] = new Node();
        if (l == r) {
            char c = arr[l];
            segTree[idx].leftChar = segTree[idx].rightChar = c;
            segTree[idx].leftCount = segTree[idx].rightCount = segTree[idx].maxCount = 1;
            return;
        }
        int mid = (l + r) / 2;
        build(idx * 2, l, mid);
        build(idx * 2 + 1, mid + 1, r);
        segTree[idx] = merge(segTree[idx * 2], segTree[idx * 2 + 1], mid - l + 1, r - mid);
    }

    private void update(int idx, int l, int r, int pos, char c) {
        if (l == r) {
            arr[pos] = c;
            segTree[idx].leftChar = segTree[idx].rightChar = c;
            segTree[idx].leftCount = segTree[idx].rightCount = segTree[idx].maxCount = 1;
            return;
        }
        int mid = (l + r) / 2;
        if (pos <= mid) update(idx * 2, l, mid, pos, c);
        else update(idx * 2 + 1, mid + 1, r, pos, c);
        segTree[idx] = merge(segTree[idx * 2], segTree[idx * 2 + 1], mid - l + 1, r - mid);
    }

    private Node merge(Node left, Node right, int leftLen, int rightLen) {
        Node res = new Node();
        res.leftChar = left.leftChar;
        res.rightChar = right.rightChar;

        res.leftCount = left.leftCount;
        if (left.leftCount == leftLen && left.rightChar == right.leftChar) {
            res.leftCount += right.leftCount;
        }

        res.rightCount = right.rightCount;
        if (right.rightCount == rightLen && left.rightChar == right.leftChar) {
            res.rightCount += left.rightCount;
        }

        res.maxCount = Math.max(left.maxCount, right.maxCount);
        if (left.rightChar == right.leftChar) {
            res.maxCount = Math.max(res.maxCount, left.rightCount + right.leftCount);
        }
        return res;
    }
}
