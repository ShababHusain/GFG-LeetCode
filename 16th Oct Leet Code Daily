class Solution {
    static final int MOD = 1_000_000_007;

    long[] sumC;
    long[] sumSq;
    long[] lazy;

    public int sumCounts(int[] nums) {
        int n = nums.length;
        sumC = new long[4 * n];
        sumSq = new long[4 * n];
        lazy = new long[4 * n];

        int[] last = new int[100005];
        Arrays.fill(last, -1);

        long totalSumSq = 0;

        for (int j = 0; j < n; j++) {
            int prev = last[nums[j]];
            int L = prev + 1;
            int R = j;

            // Update segment tree for range [L, R] by adding 1 to distinct counts
            update(1, 0, n - 1, L, R, 1);

            // The total sum of squares for all subarrays ending at j is the root's sumSq
            totalSumSq = (totalSumSq + sumSq[1]) % MOD;
            last[nums[j]] = j;
        }

        return (int) totalSumSq;
    }

    private void apply(int node, int l, int r, long val) {
        long len = (r - l + 1);
        // sumSq' = sumSq + 2 * val * sumC + val^2 * len
        sumSq[node] = (sumSq[node] + 2 * val * sumC[node] % MOD + val * val % MOD * len) % MOD;
        // sumC' = sumC + val * len
        sumC[node] = (sumC[node] + val * len) % MOD;
        lazy[node] = (lazy[node] + val) % MOD;
    }

    private void push(int node, int l, int r) {
        if (lazy[node] != 0) {
            int mid = l + (r - l) / 2;
            apply(2 * node, l, mid, lazy[node]);
            apply(2 * node + 1, mid + 1, r, lazy[node]);
            lazy[node] = 0;
        }
    }

    private void update(int node, int l, int r, int ql, int qr, long val) {
        if (ql > r || qr < l) return;
        if (ql <= l && r <= qr) {
            apply(node, l, r, val);
            return;
        }
        push(node, l, r);
        int mid = l + (r - l) / 2;
        update(2 * node, l, mid, ql, qr, val);
        update(2 * node + 1, mid + 1, r, ql, qr, val);
        sumC[node] = (sumC[2 * node] + sumC[2 * node + 1]) % MOD;
        sumSq[node] = (sumSq[2 * node] + sumSq[2 * node + 1]) % MOD;
    }
}
