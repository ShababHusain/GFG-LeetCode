class Solution {
    public int[] maxDistance(int V, int src, ArrayList<ArrayList<Integer>> edges) {
        // Build adjacency list
        List<List<int[]>> adj = new ArrayList<>();
        for (int i = 0; i < V; i++) adj.add(new ArrayList<>());
        for (ArrayList<Integer> e : edges) {
            int u = e.get(0), v = e.get(1), w = e.get(2);
            adj.get(u).add(new int[]{v, w});
        }

        // Topological sort using DFS
        boolean[] visited = new boolean[V];
        Stack<Integer> stack = new Stack<>();
        for (int i = 0; i < V; i++) {
            if (!visited[i]) dfs(i, adj, visited, stack);
        }

        // Initialize distances
        int[] dist = new int[V];
        Arrays.fill(dist, Integer.MIN_VALUE);
        dist[src] = 0;

        // Relax edges in topological order
        while (!stack.isEmpty()) {
            int u = stack.pop();
            if (dist[u] != Integer.MIN_VALUE) {
                for (int[] edge : adj.get(u)) {
                    int v = edge[0], w = edge[1];
                    dist[v] = Math.max(dist[v], dist[u] + w);
                }
            }
        }
        return dist;
    }

    private void dfs(int u, List<List<int[]>> adj, boolean[] visited, Stack<Integer> stack) {
        visited[u] = true;
        for (int[] edge : adj.get(u)) {
            int v = edge[0];
            if (!visited[v]) dfs(v, adj, visited, stack);
        }
        stack.push(u);
    }
}
