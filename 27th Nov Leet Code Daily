class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;
        int[] freeFromBuy = new int[n];
        int minPrice = Integer.MAX_VALUE;

        for (int i = 0; i < n; i++) {
            int fI = items[i][0];
            int pI = items[i][1];
            minPrice = Math.min(minPrice, pI);

            for (int j = 0; j < n; j++) {
                if (i != j && items[j][0] % fI == 0) {
                    freeFromBuy[i]++;
                }
            }
        }

        int[] dp = new int[budget + 1];

        for (int i = 0; i < n; i++) {
            int price = items[i][1];
            int val = 1 + freeFromBuy[i];
            for (int b = budget; b >= price; b--) {
                dp[b] = Math.max(dp[b], dp[b - price] + val);
            }
        }

        int ans = 0;
        for (int b = 0; b <= budget; b++) {
            int extra = (budget - b) / minPrice;
            ans = Math.max(ans, dp[b] + extra);
        }

        return ans;
    }
}
