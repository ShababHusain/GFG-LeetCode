class Solution {
    public int minimumEdgeReversal(int[][] edges, int n, int src, int dst) {
        // Build graph: original edge has weight 0, reversed edge has weight 1
        List<List<int[]>> adj = new ArrayList<>(n + 1);
        for (int i = 0; i <= n; i++) {
            adj.add(new ArrayList<>());
        }

        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];
            adj.get(u).add(new int[]{v, 0}); // Original direction (cost 0)
            adj.get(v).add(new int[]{u, 1}); // Reversed direction (cost 1)
        }

        int[] dist = new int[n + 1];
        Arrays.fill(dist, Integer.MAX_VALUE);

        Deque<Integer> deque = new ArrayDeque<>();
        dist[src] = 0;
        deque.add(src);

        // 0-1 BFS
        while (!deque.isEmpty()) {
            int curr = deque.pollFirst();

            if (curr == dst) {
                return dist[curr];
            }

            for (int[] neighbor : adj.get(curr)) {
                int nextNode = neighbor[0];
                int weight = neighbor[1];

                if (dist[curr] + weight < dist[nextNode]) {
                    dist[nextNode] = dist[curr] + weight;

                    if (weight == 0) {
                        deque.addFirst(nextNode);
                    } else {
                        deque.addLast(nextNode);
                    }
                }
            }
        }

        return dist[dst] == Integer.MAX_VALUE ? -1 : dist[dst];
    }
}
