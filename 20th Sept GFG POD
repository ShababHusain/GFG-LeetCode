class Solution {
    public int largestSubsquare(char[][] mat) {
        int n = mat.length;
        int[][] row = new int[n][n];
        int[][] col = new int[n][n];

        // Step 1: Precompute consecutive 'X' counts for rows and columns
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 'X') {
                    row[i][j] = (j == 0) ? 1 : row[i][j - 1] + 1;
                    col[i][j] = (i == 0) ? 1 : col[i - 1][j] + 1;
                }
            }
        }

        int maxSide = 0;

        // Step 2: Iterate over each cell (i, j) as the bottom-right corner of the square
        for (int i = n - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {
                // Maximum possible side ending at (i, j)
                int possibleSide = Math.min(row[i][j], col[i][j]);

                // Try side lengths from possibleSide down to maxSide + 1
                while (possibleSide > maxSide) {
                    // Check top edge and left edge
                    if (row[i - possibleSide + 1][j] >= possibleSide &&
                        col[i][j - possibleSide + 1] >= possibleSide) {
                        maxSide = possibleSide;
                        break;
                    }
                    possibleSide--;
                }
            }
        }

        return maxSide;
    }
}
