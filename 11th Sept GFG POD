class Solution {
    public int sameMod(int[] arr) {
        int n = arr.length;
        if (n <= 1) {
            return -1;
        }

        int min = arr[0];
        int max = arr[0];
        for (int val : arr) {
            min = Math.min(min, val);
            max = Math.max(max, val);
        }

        if (min == max) {
            return -1;
        }

        int g = 0;
        for (int val : arr) {
            int diff = val - min;
            if (diff > 0) {
                g = gcd(g, diff);
            }
        }

        int count = 0;
        for (int i = 1; i * i <= g; i++) {
            if (g % i == 0) {
                count++;
                if (i * i != g) {
                    count++;
                }
            }
        }

        return count;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
