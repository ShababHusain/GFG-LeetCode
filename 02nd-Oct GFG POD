class Solution {
    public int largestSumCycle(int[] edge) {
        int n = edge.length;
        int[] visited = new int[n]; // 0: unvisited, 1: visiting, 2: visited
        int maxSum = -1;

        for (int i = 0; i < n; i++) {
            if (visited[i] == 0) {
                int curr = i;
                
                // Traverse the path
                while (curr != -1 && visited[curr] == 0) {
                    visited[curr] = 1;
                    curr = edge[curr];
                }
                
                // If a cycle is detected in the current traversal path
                if (curr != -1 && visited[curr] == 1) {
                    int currentSum = 0;
                    int temp = curr;
                    do {
                        currentSum += temp;
                        temp = edge[temp];
                    } while (temp != curr);
                    
                    maxSum = Math.max(maxSum, currentSum);
                }
                
                // Mark all nodes in this traversal path as fully visited (2)
                curr = i;
                while (curr != -1 && visited[curr] == 1) {
                    visited[curr] = 2;
                    curr = edge[curr];
                }
            }
        }
        
        return maxSum;
    }
}
