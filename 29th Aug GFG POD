class Solution {
    public int countSubsequences(String s, int n) {
        int MOD = 1_000_000_007;
        int[] dp = new int[n];
        
        for (int i = 0; i < s.length(); i++) {
            int d = s.charAt(i) - '0';
            int[] nextDp = new int[n];
            
            // 1. Existing subsequences remain intact without the new digit
            for (int j = 0; j < n; j++) {
                nextDp[j] = dp[j];
            }
            
            // 2. Start a new subsequence consisting solely of the current digit
            nextDp[d % n] = (nextDp[d % n] + 1) % MOD;
            
            // 3. Append the current digit to all existing subsequences
            for (int j = 0; j < n; j++) {
                if (dp[j] > 0) {
                    int nextRem = (j * 10 + d) % n;
                    nextDp[nextRem] = (nextDp[nextRem] + dp[j]) % MOD;
                }
            }
            
            dp = nextDp;
        }
        
        return dp[0];
    }
}
