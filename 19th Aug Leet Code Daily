class Solution {
    public int maxNumberOfFamilies(int n, int[][] reservedSeats) {
        // Map row -> bitmask for seats 2..9 (bits 0..7)
        Map<Integer, Integer> map = new HashMap<>();
        for (int[] rs : reservedSeats) {
            int row = rs[0], seat = rs[1];
            if (seat >= 2 && seat <= 9) {
                int bit = 1 << (seat - 2); // seat 2 -> bit 0, seat 9 -> bit 7
                map.put(row, map.getOrDefault(row, 0) | bit);
            }
        }

        int total = 0;
        // masks for the three blocks
        final int LEFT  = 0b00001111; // seats 2-5
        final int MID   = 0b00111100; // seats 4-7
        final int RIGHT = 0b11110000; // seats 6-9

        // rows that have reservations
        for (Map.Entry<Integer, Integer> e : map.entrySet()) {
            int mask = e.getValue();
            int count = 0;
            if ((mask & LEFT) == 0) count++;           // left block free
            if ((mask & RIGHT) == 0) count++;          // right block free
            if (count == 0 && (mask & MID) == 0) count = 1; // middle only if left/right blocked
            total += count;
        }

        // rows without any reservations among seats 2..9
        int rowsWithReservations = map.size();
        total += (n - rowsWithReservations) * 2;

        return total;
    }
}
