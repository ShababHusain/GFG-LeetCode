class Solution {
    public int reverseDegree(String s) {
        int totalSum = 0;

        for (int i = 0; i < s.length(); i++) {
            // Position in reversed alphabet ('a' = 26, 'b' = 25, ..., 'z' = 1)
            int revVal = 26 - (s.charAt(i) - 'a');
            
            // Multiply by 1-based index in string
            totalSum += revVal * (i + 1);
        }

        return totalSum;
    }
}
