class Solution {
    int shortestPath(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        boolean[][] isSafe = new boolean[n][m];
        for (int i = 0; i < n; i++) {
            Arrays.fill(isSafe[i], true);
        }

        int[] dRow = {-1, 1, 0, 0};
        int[] dCol = {0, 0, -1, 1};

        // Mark landmines and adjacent cells as unsafe
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < m; c++) {
                if (mat[r][c] == 0) {
                    isSafe[r][c] = false;
                    for (int k = 0; k < 4; k++) {
                        int nr = r + dRow[k];
                        int nc = c + dCol[k];
                        if (nr >= 0 && nr < n && nc >= 0 && nc < m) {
                            isSafe[nr][nc] = false;
                        }
                    }
                }
            }
        }

        Queue<int[]> queue = new LinkedList<>();
        boolean[][] visited = new boolean[n][m];

        // Add all valid starting cells from the leftmost column
        for (int r = 0; r < n; r++) {
            if (isSafe[r][0]) {
                queue.add(new int[]{r, 0, 1}); // {row, col, distance}
                visited[r][0] = true;
            }
        }

        while (!queue.isEmpty()) {
            int[] curr = queue.poll();
            int r = curr[0];
            int c = curr[1];
            int dist = curr[2];

            // Reached rightmost column
            if (c == m - 1) {
                return dist;
            }

            for (int k = 0; k < 4; k++) {
                int nr = r + dRow[k];
                int nc = c + dCol[k];

                if (nr >= 0 && nr < n && nc >= 0 && nc < m && isSafe[nr][nc] && !visited[nr][nc]) {
                    visited[nr][nc] = true;
                    queue.add(new int[]{nr, nc, dist + 1});
                }
            }
        }

        return -1;
    }
}
