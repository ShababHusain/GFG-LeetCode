class Solution {
    public ArrayList<Integer> update(int n, int[] updates) {
        int[] arr = new int[n];

        // Step 1: Mark starting points of increments (1-based to 0-based)
        for (int j : updates) {
            arr[j - 1]++;
        }

        // Step 2: Compute prefix sums to propagate the additions
        for (int i = 1; i < n; i++) {
            arr[i] += arr[i - 1];
        }

        // Step 3: Convert array to ArrayList
        ArrayList<Integer> result = new ArrayList<>(n);
        for (int val : arr) {
            result.add(val);
        }

        return result;
    }
}
