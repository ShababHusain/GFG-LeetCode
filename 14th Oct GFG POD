class Solution {
    public String findRollOut(String s, int[] roll) {
        int n = s.length();
        int[] diff = new int[n + 1];

        // Step 1: Mark range increments using difference array
        for (int r : roll) {
            diff[0]++;
            diff[r]--;
        }

        // Step 2: Compute prefix sums to get total rolls per index and apply to string
        char[] chars = s.toCharArray();
        int currentRoll = 0;

        for (int i = 0; i < n; i++) {
            currentRoll += diff[i];
            int shifted = (chars[i] - 'a' + (currentRoll % 26)) % 26;
            chars[i] = (char) ('a' + shifted);
        }

        return new String(chars);
    }
}
