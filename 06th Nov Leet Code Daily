import java.util.*;

class Solution {
    public int[] countServers(int n, int[][] logs, int x, int[] queries) {
        int m = queries.length;
        
        // Sort logs by time (logs[i][1])
        Arrays.sort(logs, Comparator.comparingInt(a -> a[1]));
        
        // Pair queries with their original indices
        int[][] sortedQueries = new int[m][2];
        for (int i = 0; i < m; i++) {
            sortedQueries[i][0] = queries[i];
            sortedQueries[i][1] = i;
        }
        Arrays.sort(sortedQueries, Comparator.comparingInt(a -> a[0]));
        
        int[] ans = new int[m];
        int left = 0, right = 0;
        int numLogs = logs.length;
        int activeServers = 0;
        int[] serverCount = new int[n + 1];
        
        for (int i = 0; i < m; i++) {
            int qTime = sortedQueries[i][0];
            int origIdx = sortedQueries[i][1];
            int windowStart = qTime - x;
            int windowEnd = qTime;
            
            // Expand right pointer to include logs <= windowEnd
            while (right < numLogs && logs[right][1] <= windowEnd) {
                int serverId = logs[right][0];
                if (serverCount[serverId] == 0) {
                    activeServers++;
                }
                serverCount[serverId]++;
                right++;
            }
            
            // Shrink left pointer to exclude logs < windowStart
            while (left < numLogs && logs[left][1] < windowStart) {
                int serverId = logs[left][0];
                serverCount[serverId]--;
                if (serverCount[serverId] == 0) {
                    activeServers--;
                }
                left++;
            }
            
            // Servers with zero requests = total servers (n) - active servers
            ans[origIdx] = n - activeServers;
        }
        
        return ans;
    }
}
