class Solution {
    public int subarrayXor(int[] arr) {
        int n = arr.length;
        
        // If n is even, every element appears an even number of times -> total XOR is 0
        if (n % 2 == 0) {
            return 0;
        }
        
        // If n is odd, XOR all elements at even indices
        int result = 0;
        for (int i = 0; i < n; i += 2) {
            result ^= arr[i];
        }
        
        return result;
    }
}
