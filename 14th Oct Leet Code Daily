class Solution {
    public String maxSumOfSquares(int num, int sum) {
        if (sum < 1 || sum > 9L * num) {
            return "";
        }

        int[] digits = new int[num];
        long rem = sum;

        for (int i = 0; i < num; i++) {
            long remainingSlots = num - 1 - i;
            long take = Math.min(9, rem);
            
            if (rem - take > 9L * remainingSlots) {
                take = rem - 9L * remainingSlots;
            }
            
            digits[i] = (int) take;
            rem -= take;
        }

        StringBuilder sb = new StringBuilder();
        for (int d : digits) {
            sb.append(d);
        }
        return sb.toString();
    }
}
