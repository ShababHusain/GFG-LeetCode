class Solution {
    public int minTime(int n, int s1, int s2) {
        long low = 0;
        long high = (long) Math.max(s1, s2) * n;
        long ans = high;
        
        while (low <= high) {
            long mid = low + (high - low) / 2;
            long count = (mid / s1) + (mid / s2);
            
            if (count >= n) {
                ans = mid;
                high = mid - 1; // Try to find a smaller valid time
            } else {
                low = mid + 1; // Need more time
            }
        }
        
        return (int) ans;
    }
}
