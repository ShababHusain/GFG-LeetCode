import java.util.*;

class Solution {
    public boolean checkPath(ArrayList<ArrayList<Integer>> adj, int u, int v) {
        if (u == v) {
            return true;
        }

        int n = adj.size();
        boolean[] visited = new boolean[n];
        Queue<Integer> queue = new ArrayDeque<>();

        visited[u] = true;
        queue.offer(u);

        while (!queue.isEmpty()) {
            int curr = queue.poll();
            if (curr == v) {
                return true;
            }

            for (int nxt : adj.get(curr)) {
                if (!visited[nxt]) {
                    visited[nxt] = true;
                    queue.offer(nxt);
                }
            }
        }

        return false;
    }
}
