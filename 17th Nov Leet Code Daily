
class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        int[][] g = new int[n][n];
        for (int[] row : g) {
            Arrays.fill(row, 1_000_000);
        }
        
        // Precompute cost g[i][j] for substring s[i...j]
        for (int length = 2; length <= n; length++) {
            for (int i = 0; i <= n - length; i++) {
                int j = i + length - 1;
                for (int d = 1; d < length; d++) {
                    if (length % d == 0) {
                        int cost = 0;
                        for (int offset = 0; offset < d; offset++) {
                            int l = i + offset;
                            int r = j - d + 1 + offset;
                            while (l < r) {
                                if (s.charAt(l) != s.charAt(r)) {
                                    cost++;
                                }
                                l += d;
                                r -= d;
                            }
                        }
                        g[i][j] = Math.min(g[i][j], cost);
                    }
                }
            }
        }
        
        // DP to partition into k parts
        int[][] dp = new int[n + 1][k + 1];
        for (int[] row : dp) {
            Arrays.fill(row, 1_000_000);
        }
        dp[0][0] = 0;
        
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= Math.min(i, k); j++) {
                for (int h = j - 1; h < i; h++) {
                    dp[i][j] = Math.min(dp[i][j], dp[h][j - 1] + g[h][i - 1]);
                }
            }
        }
        
        return dp[n][k];
    }
}
