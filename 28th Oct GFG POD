import java.util.HashSet;
import java.util.Set;

class Solution {
    public int minCost(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        
        Set<Integer>[] dp = new HashSet[n];
        for (int j = 0; j < n; j++) {
            dp[j] = new HashSet<>();
        }
        
        dp[0].add(grid[0][0]);
        
        for (int j = 1; j < n; j++) {
            for (int val : dp[j - 1]) {
                dp[j].add(val ^ grid[0][j]);
            }
        }
        
        for (int i = 1; i < m; i++) {
            Set<Integer> nextRowFirst = new HashSet<>();
            for (int val : dp[0]) {
                nextRowFirst.add(val ^ grid[i][0]);
            }
            dp[0] = nextRowFirst;
            
            for (int j = 1; j < n; j++) {
                Set<Integer> currentCellSets = new HashSet<>();
                for (int val : dp[j]) {
                    currentCellSets.add(val ^ grid[i][j]);
                }
                for (int val : dp[j - 1]) {
                    currentCellSets.add(val ^ grid[i][j]);
                }
                dp[j] = currentCellSets;
            }
        }
        
        int minXor = Integer.MAX_VALUE;
        for (int val : dp[n - 1]) {
            minXor = Math.min(minXor, val);
        }
        
        return minXor;
    }
}
