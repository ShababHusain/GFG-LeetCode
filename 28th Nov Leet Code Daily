import java.util.*;

class Solution {
    private static class Option {
        final int gain;
        final long cost;
        final long count; // -1 for unlimited

        Option(int gain, long cost, long count) {
            this.gain = gain;
            this.cost = cost;
            this.count = count;
        }
    }

    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;
        int maxF = 0;
        for (int[] item : items) {
            if (item[0] > maxF) {
                maxF = item[0];
            }
        }

        int[] factorCount = new int[maxF + 1];
        for (int[] item : items) {
            factorCount[item[0]]++;
        }

        int[] multiplesCount = new int[maxF + 1];
        for (int f = 1; f <= maxF; f++) {
            for (int mult = f; mult <= maxF; mult += f) {
                multiplesCount[f] += factorCount[mult];
            }
        }

        List<Option> options = new ArrayList<>(n * 2);
        for (int[] item : items) {
            int f = item[0];
            long price = item[1];
            long freeCnt = multiplesCount[f] - 1L;
            if (freeCnt > 0) {
                options.add(new Option(2, price, freeCnt));
            }
            options.add(new Option(1, price, -1L));
        }

        options.sort((a, b) -> Long.compare((long) b.gain * a.cost, (long) a.gain * b.cost));

        long totalItems = 0;
        long remBudget = budget;

        for (Option opt : options) {
            if (remBudget < opt.cost) {
                continue;
            }
            long maxAffordable = remBudget / opt.cost;
            long take = (opt.count == -1L) ? maxAffordable : Math.min(opt.count, maxAffordable);

            totalItems += take * opt.gain;
            remBudget -= take * opt.cost;
            if (remBudget == 0) {
                break;
            }
        }

        return (int) totalItems;
    }
}
