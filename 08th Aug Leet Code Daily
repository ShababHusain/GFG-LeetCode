class Solution {
    public int[] validSequence(String word1, String word2) {
        char[] w1 = word1.toCharArray();
        char[] w2 = word2.toCharArray();
        int n = w1.length;
        int m = w2.length;
        
        // R[i] tracks the maximal starting index in w1 to perfectly match w2[i...m-1]
        int[] R = new int[m + 1];
        R[m] = n;
        int j = n - 1;
        for (int i = m - 1; i >= 0; i--) {
            while (j >= 0 && w1[j] != w2[i]) {
                j--;
            }
            R[i] = j;
            j--;
        }
        
        // R_1[i] tracks the maximal starting index in w1 to match w2[i...m-1] with at most 1 mismatch
        int[] R_1 = new int[m + 1];
        R_1[m] = n;
        int j1 = n - 1;
        for (int i = m - 1; i >= 0; i--) {
            int match_idx = j1;
            while (match_idx >= 0 && w1[match_idx] != w2[i]) {
                match_idx--;
            }
            R_1[i] = Math.max(match_idx, R[i + 1] - 1);
            j1 = R_1[i] - 1;
        }
        
        // Group indices of characters in w1 to allow O(log N) fast lookups
        int[][] pos = new int[26][];
        int[] count = new int[26];
        for (int i = 0; i < n; i++) {
            count[w1[i] - 'a']++;
        }
        for (int i = 0; i < 26; i++) {
            pos[i] = new int[count[i]];
        }
        int[] p_idx = new int[26];
        for (int i = 0; i < n; i++) {
            int c = w1[i] - 'a';
            pos[c][p_idx[c]++] = i;
        }
        
        int[] seq = new int[m];
        boolean changed = false;
        int prev_k = -1;
        
        // Greedily find the lexicographically smallest sequence
        for (int i = 0; i < m; i++) {
            char c2 = w2[i];
            
            if (changed) { // Must perfectly match all the remaining characters exactly
                int k = getNext(pos, c2, prev_k + 1, n);
                if (k < R[i + 1]) {
                    seq[i] = k;
                } else {
                    return new int[0];
                }
            } else {
                if (prev_k + 1 < R[i + 1]) {  // Re-allocating our mismatch bounds is maximally optimal
                    int k = prev_k + 1;
                    seq[i] = k;
                    if (w1[k] != c2) {
                        changed = true;
                    }
                } else {
                    int k = getNext(pos, c2, prev_k + 1, n); // Can't drop a mismatch blindly, rely on an exact character mapping
                    if (k < R_1[i + 1]) {
                        seq[i] = k;
                    } else {
                        return new int[0];
                    }
                }
            }
            prev_k = seq[i];
        }
        
        return seq;
    }
    
    // Internal helper method triggering binary search to efficiently return the earliest index of character `c` >= `j`
    private int getNext(int[][] pos, char c, int j, int n) {
        int[] p = pos[c - 'a'];
        int l = 0, r = p.length - 1;
        int res = n;
        
        while (l <= r) {
            int mid = (l + r) >>> 1;
            if (p[mid] >= j) {
                res = p[mid];
                r = mid - 1;
            } else {
                l = mid + 1;
            }
        }
        
        return res;
    }
}
