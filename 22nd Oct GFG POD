class Solution {
    public int minimumSum(String s) {
        int n = s.length();
        int answer = 0;
        char previous = 0;
        boolean hasPrevious = false;
        
        // Process only the left half of the string
        for (int i = 0; i < n / 2; i++) {
            char left = s.charAt(i);
            char right = s.charAt(n - 1 - i);
            char current = 0;
            
            if (left != '?' && right != '?') {
                if (left != right) {
                    return -1; // Cannot form a palindrome
                }
                current = left;
            } else if (left != '?') {
                current = left;
            } else if (right != '?') {
                current = right;
            } else {
                continue; // Both are '?', skip for now
            }
            
            // Add the difference from the previous fixed character (counted for both halves)
            if (hasPrevious) {
                answer += 2 * Math.abs(current - previous);
            }
            previous = current;
            hasPrevious = true;
        }
        
        return answer;
    }
}
