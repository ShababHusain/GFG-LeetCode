class Solution {
    public int smallestNumber(int n, int t) {
        while (true) {
            if (digitProduct(n) % t == 0) {
                return n;
            }
            n++;
        }
    }
    
    private int digitProduct(int num) {
        if (num == 0) return 0;
        int product = 1;
        while (num > 0) {
            int d = num % 10;
            product *= d;
            num /= 10;
        }
        return product;
    }
}
