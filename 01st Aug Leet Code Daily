class Solution {
    public boolean predictTheWinner(int[] nums) {
        int n = nums.length;
        Integer[][] memo = new Integer[n][n];
        return helper(nums, 0, n - 1, memo) >= 0;
    }

    private int helper(int[] nums, int l, int r, Integer[][] memo) {
        if (l == r) return nums[l]; // only one number left
        if (memo[l][r] != null) return memo[l][r];

        // If current player picks left
        int pickLeft = nums[l] - helper(nums, l + 1, r, memo);
        // If current player picks right
        int pickRight = nums[r] - helper(nums, l, r - 1, memo);

        memo[l][r] = Math.max(pickLeft, pickRight);
        return memo[l][r];
    }
}
