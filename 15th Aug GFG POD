class Solution {
    private String num;
    private int forbidden;
    private long[][][] dp; // use long to store counts; -1 means uncomputed

    public int countWithout(int n, int d) {
        if (n <= 0) return 0;           // no numbers in [1..0]
        num = String.valueOf(n);
        forbidden = d;
        dp = new long[num.length()][2][2];
        for (int i = 0; i < dp.length; ++i)
            for (int j = 0; j < 2; ++j)
                for (int k = 0; k < 2; ++k)
                    dp[i][j][k] = -1L;
        long ans = dfs(0, 1, 0);
        return (int) ans;
    }

    // pos: current index in num
    // tight: 1 if prefix equals num's prefix, else 0
    // started: 1 if we've placed a non-leading digit, else 0
    private long dfs(int pos, int tight, int started) {
        if (pos == num.length()) {
            return started == 1 ? 1L : 0L; // count valid numbers (exclude all-leading-zero)
        }
        if (dp[pos][tight][started] != -1L) return dp[pos][tight][started];

        int limit = tight == 1 ? num.charAt(pos) - '0' : 9;
        long res = 0L;

        for (int dig = 0; dig <= limit; dig++) {
            int newStarted = (started == 1 || dig != 0) ? 1 : 0;

            // Skip forbidden digit only when the number has actually started.
            // Leading zeros do not count as containing digit 0.
            if (newStarted == 1 && dig == forbidden) continue;

            int newTight = (tight == 1 && dig == limit) ? 1 : 0;
            res += dfs(pos + 1, newTight, newStarted);
        }

        dp[pos][tight][started] = res;
        return res;
    }
}
