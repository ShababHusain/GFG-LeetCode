import java.util.Arrays;

class Solution {
    public int climbStairs(int n, int[] costs) {
        long[] dp = new long[n + 1];
        long inf = Long.MAX_VALUE / 2;
        Arrays.fill(dp, inf);
        dp[0] = 0;
        
        for (int i = 1; i <= n; i++) {
            long costI = costs[i - 1];
            for (int j = Math.max(0, i - 3); j < i; j++) {
                long jumpCost = (long) (i - j) * (i - j);
                dp[i] = Math.min(dp[i], dp[j] + costI + jumpCost);
            }
        }
        
        return (int) dp[n];
    }
}
