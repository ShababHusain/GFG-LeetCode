class Solution {
    public static int countPairs(int arr[], int k) {
        int n = arr.length;
        Arrays.sort(arr);  // Step 1: Sort the array
        int count = 0;
        
        int j = 0;
        // Step 2: Two-pointer approach
        for (int i = 0; i < n; i++) {
            while (j < n && arr[j] - arr[i] < k) {
                j++;
            }
            // All indices between i+1 and j-1 form valid pairs with i
            count += (j - i - 1);
        }
        
        return count;
    }
}
