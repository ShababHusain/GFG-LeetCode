class Solution {
    public ArrayList<ArrayList<Integer>> formCoils(int n) {
        int totalElements = 8 * n * n;
        int maxVal = 16 * n * n;

        ArrayList<Integer> coil1 = new ArrayList<>(totalElements);
        ArrayList<Integer> coil2 = new ArrayList<>(totalElements);

        int r = 0, c = 0;
        int matrixWidth = 4 * n;

        // Coil 1 starts at top-left (0,0) with value 1
        coil1.add(1);

        // Directions: Down (0), Right (1), Up (2), Left (3)
        int[] dr = {1, 0, -1, 0};
        int[] dc = {0, 1, 0, -1};
        int dir = 0;

        // Initial leg down (4n - 1 steps)
        int stepLen = 4 * n - 1;
        for (int i = 0; i < stepLen; i++) {
            r += dr[dir];
            c += dc[dir];
            coil1.add(r * matrixWidth + c + 1);
        }
        dir = (dir + 1) % 4;

        // Subsequent leg pairs starting at 4n - 2 steps, decreasing by 2
        stepLen = 4 * n - 2;
        while (coil1.size() < totalElements) {
            for (int leg = 0; leg < 2 && coil1.size() < totalElements; leg++) {
                for (int i = 0; i < stepLen && coil1.size() < totalElements; i++) {
                    r += dr[dir];
                    c += dc[dir];
                    coil1.add(r * matrixWidth + c + 1);
                }
                dir = (dir + 1) % 4;
            }
            stepLen -= 2;
        }

        // Derive Coil 2 using 180-degree symmetric complement
        for (int val : coil1) {
            coil2.add((maxVal + 1) - val);
        }

        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        result.add(coil1);
        result.add(coil2);

        return result;
    }
}
