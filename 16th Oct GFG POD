class Solution {
    public int countAlwaysFound(int[] arr) {
        int n = arr.length;
        if (n == 0) return 0;

        int[] prefMax = new int[n];
        prefMax[0] = arr[0];
        for (int i = 1; i < n; i++) {
            prefMax[i] = Math.max(prefMax[i - 1], arr[i]);
        }

        int[] sufMin = new int[n];
        sufMin[n - 1] = arr[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            sufMin[i] = Math.min(sufMin[i + 1], arr[i]);
        }

        int count = 0;
        for (int i = 0; i < n; i++) {
            if (arr[i] == prefMax[i] && arr[i] == sufMin[i]) {
                count++;
            }
        }

        return count;
    }
}
