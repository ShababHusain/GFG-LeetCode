class Solution {
    public int findPerimeter(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;
        int perimeter = 0;

        for (int r = 0; r < n; r++) {
            for (int c = 0; c < m; c++) {
                if (mat[r][c] == 1) {
                    perimeter += 4;

                    // Check right neighbor
                    if (c + 1 < m && mat[r][c + 1] == 1) {
                        perimeter -= 2;
                    }

                    // Check bottom neighbor
                    if (r + 1 < n && mat[r + 1][c] == 1) {
                        perimeter -= 2;
                    }
                }
            }
        }

        return perimeter;
    }
}
