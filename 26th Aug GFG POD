class Solution {
    public boolean isNegativeWeightCycle(int V, int[][] edges) {
        // Use long to avoid overflow when summing weights
        long[] dist = new long[V]; // initialized to 0 (super-source trick)

        // Relax edges V-1 times
        for (int i = 0; i < V - 1; ++i) {
            boolean updated = false;
            for (int[] e : edges) {
                int u = e[0], v = e[1], w = e[2];
                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                    updated = true;
                }
            }
            if (!updated) break;
        }

        // One more pass to detect negative cycle
        for (int[] e : edges) {
            int u = e[0], v = e[1], w = e[2];
            if (dist[u] + w < dist[v]) return true;
        }
        return false;
    }
}
