class Solution {
    public int largestInteger(int[] nums, int k) {
        int n = nums.length;
        if (n == 0 || k <= 0 || k > n) return -1;

        final int MAXV = 50;
        int[] windowAppearCount = new int[MAXV + 1];

        // For each window, mark which values appear and increment their window count
        for (int start = 0; start + k <= n; start++) {
            boolean[] seen = new boolean[MAXV + 1];
            for (int j = start; j < start + k; j++) {
                seen[nums[j]] = true;
            }
            for (int v = 0; v <= MAXV; v++) {
                if (seen[v]) windowAppearCount[v]++;
            }
        }

        // return largest value that appears in exactly one window
        for (int v = MAXV; v >= 0; v--) {
            if (windowAppearCount[v] == 1) return v;
        }
        return -1;
    }
}
