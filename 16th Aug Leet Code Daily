class Solution {
    public boolean stoneGameIX(int[] stones) {
        int c0 = 0, c1 = 0, c2 = 0;
        for (int v : stones) {
            int r = v % 3;
            if (r == 0) c0++;
            else if (r == 1) c1++;
            else c2++;
        }

        if (c0 % 2 == 0) {
            // even zeros: Alice wins only if both types 1 and 2 exist
            return c1 > 0 && c2 > 0;
        } else {
            // odd zeros: Alice wins if difference between c1 and c2 is greater than 2
            return Math.abs(c1 - c2) > 2;
        }
    }
}
