class Solution {
    public int minimumDeletions(int[] nums) {
        int n = nums.length;
        int minIdx = 0, maxIdx = 0;
        
        // Locate the indices of the minimum and maximum elements
        for (int i = 1; i < n; i++) {
            if (nums[i] < nums[minIdx]) minIdx = i;
            if (nums[i] > nums[maxIdx]) maxIdx = i;
        }
        
        int first = Math.min(minIdx, maxIdx);
        int last = Math.max(minIdx, maxIdx);
        
        // Strategy 1: Remove both from the front
        int deleteFront = last + 1;
        
        // Strategy 2: Remove both from the back
        int deleteBack = n - first;
        
        // Strategy 3: Remove the earlier element from the front and the later one from the back
        int deleteBoth = (first + 1) + (n - last);
        
        return Math.min(deleteFront, Math.min(deleteBack, deleteBoth));
    }
}
