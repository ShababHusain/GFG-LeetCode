class Solution {
    public int formPyramid(int[] arr) {
        int n = arr.length;
        int[] left = new int[n];
        int[] right = new int[n];

        long totalSum = 0;
        for (int val : arr) {
            totalSum += val;
        }

        // 1. Calculate maximum possible height bound from left
        left[0] = Math.min(arr[0], 1);
        for (int i = 1; i < n; i++) {
            left[i] = Math.min(arr[i], left[i - 1] + 1);
        }

        // 2. Calculate maximum possible height bound from right
        right[n - 1] = Math.min(arr[n - 1], 1);
        for (int i = n - 2; i >= 0; i--) {
            right[i] = Math.min(arr[i], right[i + 1] + 1);
        }

        // 3. Find global maximum pyramid peak height
        long maxPeak = 0;
        for (int i = 0; i < n; i++) {
            long currentPeak = Math.min(left[i], right[i]);
            maxPeak = Math.max(maxPeak, currentPeak);
        }

        // 4. Total reductions required = Total sum - sum of pyramid elements (maxPeak^2)
        return (int) (totalSum - (maxPeak * maxPeak));
    }
}
