class Solution {
    static boolean isPossible(int n, int m, String s) {
        int curR = 0, minR = 0, maxR = 0;
        int curC = 0, minC = 0, maxC = 0;
        
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == 'L') {
                curC--;
            } else if (ch == 'R') {
                curC++;
            } else if (ch == 'D') {
                curR--;
            } else if (ch == 'U') {
                curR++;
            }
            
            minR = Math.min(minR, curR);
            maxR = Math.max(maxR, curR);
            minC = Math.min(minC, curC);
            maxC = Math.max(maxC, curC);
        }
        
        int rowSpan = maxR - minR + 1;
        int colSpan = maxC - minC + 1;
        
        return rowSpan <= n && colSpan <= m;
    }
}
