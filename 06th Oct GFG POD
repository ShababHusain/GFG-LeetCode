class Solution {
    private int[][] dp;
    private int rows, cols;
    private final int[][] dirs = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};

    public int longIncPath(int[][] matrix, int n, int m) {
        rows = n;
        cols = m;
        dp = new int[n][m];

        int maxLength = 0;

        for (int r = 0; r < n; r++) {
            for (int c = 0; c < m; c++) {
                maxLength = Math.max(maxLength, dfs(matrix, r, c));
            }
        }

        return maxLength;
    }

    private int dfs(int[][] matrix, int r, int c) {
        if (dp[r][c] != 0) {
            return dp[r][c];
        }

        int maxLen = 1;

        for (int[] dir : dirs) {
            int nr = r + dir[0];
            int nc = c + dir[1];

            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && matrix[nr][nc] > matrix[r][c]) {
                maxLen = Math.max(maxLen, 1 + dfs(matrix, nr, nc));
            }
        }

        dp[r][c] = maxLen;
        return maxLen;
    }
}
