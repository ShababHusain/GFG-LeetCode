class Solution {
    public int countBT(int h) {
        if (h <= 1) {
            return 1;
        }
        
        long MOD = 1_000_000_007;
        long prev2 = 1; // Represents height 0 (empty tree)
        long prev1 = 1; // Represents height 1 (single node tree)
        long curr = 1;
        
        for (int i = 2; i <= h; i++) {
            curr = (prev1 * prev1 % MOD + 2 * prev1 % MOD * prev2 % MOD) % MOD;
            prev2 = prev1;
            prev1 = curr;
        }
        
        return (int) prev1;
    }
}
