class Solution {
    public int minSquares(int n, int m) {
        int res = 0;

        while (n > 0 && m > 0) {
            if (n < m) {
                int temp = n;
                n = m;
                m = temp;
            }
            res += n / m;
            n %= m;
        }

        return res;
    }
}
