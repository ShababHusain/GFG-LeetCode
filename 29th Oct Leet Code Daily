import java.util.*;

class Solution {
    private List<Integer>[] tree;
    private int[] parent, depth, heavy, head, pos, sz, nodeOfPos;
    private int[] val;
    private int curPos;
    private int[] treeSeg;

    public List<Boolean> palindromePath(int n, int[][] edges, String s, String[] queries) {
        tree = new ArrayList[n];
        for (int i = 0; i < n; i++) tree[i] = new ArrayList<>();
        for (int[] edge : edges) {
            tree[edge[0]].add(edge[1]);
            tree[edge[1]].add(edge[0]);
        }

        parent = new int[n];
        depth = new int[n];
        heavy = new int[n];
        head = new int[n];
        pos = new int[n];
        sz = new int[n];
        nodeOfPos = new int[n];
        val = new int[n];
        
        Arrays.fill(heavy, -1);
        for (int i = 0; i < n; i++) {
            val[i] = 1 << (s.charAt(i) - 'a');
        }

        dfs1(0, -1, 0);
        curPos = 0;
        dfs2(0, 0);

        treeSeg = new int[4 * n];
        build(1, 0, n - 1);

        List<Boolean> result = new ArrayList<>();
        for (String q : queries) {
            String[] parts = q.split(" ");
            if (parts[0].equals("update")) {
                int u = Integer.parseInt(parts[1]);
                int newVal = 1 << (parts[2].charAt(0) - 'a');
                val[u] = newVal;
                update(1, 0, n - 1, pos[u], newVal);
            } else {
                int u = Integer.parseInt(parts[1]);
                int v = Integer.parseInt(parts[2]);
                int pathMask = queryPath(u, v, n);
                result.add(pathMask == 0 || (pathMask & (pathMask - 1)) == 0);
            }
        }

        return result;
    }

    private int dfs1(int u, int p, int d) {
        parent[u] = p;
        depth[u] = d;
        sz[u] = 1;
        int maxSubtree = 0;
        for (int v : tree[u]) {
            if (v != p) {
                int subSize = dfs1(v, u, d + 1);
                sz[u] += subSize;
                if (subSize > maxSubtree) {
                    maxSubtree = subSize;
                    heavy[u] = v;
                }
            }
        }
        return sz[u];
    }

    private void dfs2(int u, int h) {
        head[u] = h;
        pos[u] = curPos;
        nodeOfPos[curPos] = u;
        curPos++;
        if (heavy[u] != -1) {
            dfs2(heavy[u], h);
        }
        for (int v : tree[u]) {
            if (v != parent[u] && v != heavy[u]) {
                dfs2(v, v);
            }
        }
    }

    private void build(int node, int l, int r) {
        if (l == r) {
            treeSeg[node] = val[nodeOfPos[l]];
            return;
        }
        int mid = (l + r) / 2;
        build(2 * node, l, mid);
        build(2 * node + 1, mid + 1, r);
        treeSeg[node] = treeSeg[2 * node] ^ treeSeg[2 * node + 1];
    }

    private void update(int node, int l, int r, int idx, int newVal) {
        if (l == r) {
            treeSeg[node] = newVal;
            return;
        }
        int mid = (l + r) / 2;
        if (idx <= mid) update(2 * node, l, mid, idx, newVal);
        else update(2 * node + 1, mid + 1, r, idx, newVal);
        treeSeg[node] = treeSeg[2 * node] ^ treeSeg[2 * node + 1];
    }

    private int queryPath(int u, int v, int n) {
        int res = 0;
        while (head[u] != head[v]) {
            if (depth[head[u]] < depth[head[v]]) {
                int temp = u; u = v; v = temp;
            }
            res ^= querySeg(1, 0, n - 1, pos[head[u]], pos[u]);
            u = parent[head[u]];
        }
        if (depth[u] > depth[v]) {
            int temp = u; u = v; v = temp;
        }
        res ^= querySeg(1, 0, n - 1, pos[u], pos[v]);
        return res;
    }

    private int querySeg(int node, int l, int r, int ql, int qr) {
        if (qr < l || ql > r) return 0;
        if (ql <= l && r <= qr) return treeSeg[node];
        int mid = (l + r) / 2;
        return querySeg(2 * node, l, mid, ql, qr) ^ querySeg(2 * node + 1, mid + 1, r, ql, qr);
    }
}
