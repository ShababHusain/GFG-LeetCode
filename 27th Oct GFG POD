class Solution {
    public int getMaxWeight(String s) {
        int n = s.length();
        if (n == 0) return 0;
        
        int[] dp = new int[n + 1];
        dp[0] = 0;
        dp[1] = 1;
        
        for (int i = 2; i <= n; i++) {
            int pairWeight = (s.charAt(i - 1) != s.charAt(i - 2)) ? 4 : 3;
            dp[i] = Math.max(dp[i - 1] + 1, dp[i - 2] + pairWeight);
        }
        
        return dp[n];
    }
}
