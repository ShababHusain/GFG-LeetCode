import java.util.Arrays;

class Solution {
    public int sortableIntegers(int[] nums) {
        int n = nums.length;
        int[] sortedNums = nums.clone();
        Arrays.sort(sortedNums);
        
        long totalSum = 0;
        
        for (int k = 1; k * k <= n; k++) {
            if (n % k == 0) {
                if (isValid(nums, sortedNums, k)) {
                    totalSum += k;
                }
                int k2 = n / k;
                if (k2 != k) {
                    if (isValid(nums, sortedNums, k2)) {
                        totalSum += k2;
                    }
                }
            }
        }
        
        return (int) totalSum;
    }
    
    private boolean isValid(int[] nums, int[] sortedNums, int k) {
        int n = nums.length;
        int[] A = new int[k];
        int[] B = new int[k];
        
        for (int i = 0; i < n; i += k) {
            System.arraycopy(nums, i, A, 0, k);
            System.arraycopy(sortedNums, i, B, 0, k);
            
            if (!isCyclicMatchKMP(A, B, k)) {
                return false;
            }
        }
        return true;
    }
    
    private boolean isCyclicMatchKMP(int[] A, int[] B, int k) {
        // Construct text = A + A to handle all cyclic shifts linearly
        int[] text = new int[2 * k];
        System.arraycopy(A, 0, text, 0, k);
        System.arraycopy(A, 0, text, k, k);
        
        // Build LPS array for pattern B
        int[] lps = new int[k];
        int len = 0;
        int i = 1;
        while (i < k) {
            if (B[i] == B[len]) {
                len++;
                lps[i] = len;
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }
        
        // Search B in text using KMP
        i = 0; // index for text
        int j = 0; // index for B
        while (i < 2 * k) {
            if (B[j] == text[i]) {
                i++;
                j++;
            }
            if (j == k) {
                if (i - j <= k) { // Valid rotation must start within the first block of A + A
                    return true;
                }
                j = lps[j - 1];
            } else if (i < 2 * k && B[j] != text[i]) {
                if (j != 0) {
                    j = lps[j - 1];
                } else {
                    i++;
                }
            }
        }
        return false;
    }
}
