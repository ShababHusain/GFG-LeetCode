class Solution {
    public boolean sumGame(String num) {
        int n = num.length();
        int half = n / 2;

        int sumL = 0, sumR = 0;
        int qL = 0, qR = 0;

        for (int i = 0; i < half; ++i) {
            char ch = num.charAt(i);
            if (ch == '?') qL++;
            else sumL += ch - '0';
        }
        for (int i = half; i < n; ++i) {
            char ch = num.charAt(i);
            if (ch == '?') qR++;
            else sumR += ch - '0';
        }

        int diff = sumL - sumR;
        int qDiff = qL - qR;

        // Case: equal number of question marks
        if (qDiff == 0) {
            // If sums already differ, Alice wins; otherwise Bob can mirror and win.
            return diff != 0;
        }

        // If difference in question marks is odd, Alice can force a win
        if ((qDiff & 1) != 0) return true;

        // difference is even: Bob can force equality only if diff == 9 * ((qR - qL)/2)
        int k = (qR - qL) / 2; // note sign: qR - qL
        return diff != 9 * k;
    }
}
