class Solution {
    public int countCommas(int n) {
        int totalCommas = 0;
        long step = 1000;
        
        // Count the numbers strictly greater than or equal to each comma boundary
        while (n >= step) {
            totalCommas += (n - step + 1);
            step *= 1000;
        }
        
        return totalCommas;
    }
}
