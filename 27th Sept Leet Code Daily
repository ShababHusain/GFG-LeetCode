class Solution {
    public String reverseParentheses(String s) {
        int n = s.length();
        int[] pair = new int[n];
        Deque<Integer> stack = new ArrayDeque<>();

        // Step 1: Precompute matching parentheses pairs
        for (int i = 0; i < n; i++) {
            char c = s.charAt(i);
            if (c == '(') {
                stack.push(i);
            } else if (c == ')') {
                int openIdx = stack.pop();
                pair[i] = openIdx;
                pair[openIdx] = i;
            }
        }

        // Step 2: Traverse string with direction switching
        StringBuilder sb = new StringBuilder();
        int step = 1;

        for (int curr = 0; curr < n; curr += step) {
            char c = s.charAt(curr);
            if (c == '(' || c == ')') {
                curr = pair[curr]; // Teleport to matching bracket
                step = -step;     // Reverse traversal direction
            } else {
                sb.append(c);
            }
        }

        return sb.toString();
    }
}
