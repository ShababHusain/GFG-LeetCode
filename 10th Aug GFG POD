class Solution {
    public int maxTask(int[] h, int[] l) {
        int n = h.length;
        int[][] dp = new int[n][3];
        
        // Base case
        dp[0][0] = 0;
        dp[0][1] = l[0];
        dp[0][2] = h[0];
        
        for (int i = 1; i < n; i++) {
            // No task today
            dp[i][0] = Math.max(dp[i-1][0], Math.max(dp[i-1][1], dp[i-1][2]));
            
            // Low-effort task today
            dp[i][1] = Math.max(dp[i-1][0], Math.max(dp[i-1][1], dp[i-1][2])) + l[i];
            
            // High-effort task today (only if yesterday was no task)
            dp[i][2] = dp[i-1][0] + h[i];
        }
        
        return Math.max(dp[n-1][0], Math.max(dp[n-1][1], dp[n-1][2]));
    }
}
