class Solution {
    public long countCommas(long n) {
        long totalCommas = 0;
        long step = 1000;
        
        // Sum the contributions from each comma tier (10^3, 10^6, 10^9, 10^12, 10^15)
        while (n >= step) {
            totalCommas += (n - step + 1);
            
            // Prevent potential overflow for step multiplication
            if (step > Long.MAX_VALUE / 1000) {
                break;
            }
            step *= 1000;
        }
        
        return totalCommas;
    }
}
