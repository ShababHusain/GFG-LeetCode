class Solution {
    public int findMax(int n, int[] a, int[] b, int[] k) {
        long[] diff = new long[n + 1]; // use long to avoid overflow

        for (int i = 0; i < a.length; i++) {
            diff[a[i]] += k[i];
            if (b[i] + 1 < n) {
                diff[b[i] + 1] -= k[i];
            }
        }

        long maxVal = Long.MIN_VALUE;
        long curr = 0;
        for (int i = 0; i < n; i++) {
            curr += diff[i];
            maxVal = Math.max(maxVal, curr);
        }

        return (int) maxVal;
    }
}
