class Solution {
    public int numberOfCells(int r, int c, int u, int d, char[][] mat) {
        int n = mat.length;
        if (n == 0) return 0;
        int m = mat[0].length;
        if (r < 0 || r >= n || c < 0 || c >= m) return 0;
        if (mat[r][c] == '#') return 0;

        final int INF = Integer.MAX_VALUE / 4;
        int[][] minUp = new int[n][m];
        for (int i = 0; i < n; ++i) Arrays.fill(minUp[i], INF);

        ArrayDeque<int[]> dq = new ArrayDeque<>();
        minUp[r][c] = 0;
        dq.addFirst(new int[]{r, c, 0});

        int[] dr = {-1, 1, 0, 0}; // up, down, left, right
        int[] dc = {0, 0, -1, 1};

        while (!dq.isEmpty()) {
            int[] cur = dq.pollFirst();
            int i = cur[0], j = cur[1], upUsed = cur[2];

            if (upUsed != minUp[i][j]) continue;

            for (int k = 0; k < 4; ++k) {
                int ni = i + dr[k], nj = j + dc[k];
                if (ni < 0 || ni >= n || nj < 0 || nj >= m) continue;
                if (mat[ni][nj] == '#') continue;

                int newUp = upUsed;
                if (k == 0) newUp = upUsed + 1; // moving up costs 1

                if (newUp > u) continue;

                int downUsed = newUp - (r - ni);
                if (downUsed < 0) downUsed = 0;
                if (downUsed > d) continue;

                if (newUp < minUp[ni][nj]) {
                    minUp[ni][nj] = newUp;
                    if (k == 0) dq.addLast(new int[]{ni, nj, newUp});
                    else dq.addFirst(new int[]{ni, nj, newUp});
                }
            }
        }

        int count = 0;
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < m; ++j) {
                if (mat[i][j] == '#') continue;
                if (minUp[i][j] == INF) continue;
                int upUsed = minUp[i][j];
                int downUsed = upUsed - (r - i);
                if (downUsed < 0) downUsed = 0;
                if (upUsed <= u && downUsed <= d) count++;
            }
        }
        return count;
    }
}
