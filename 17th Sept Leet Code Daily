class Solution {
    public int minSumOfLengths(int[] arr, int target) {
        int n = arr.length;
        int[] minLen = new int[n];
        Arrays.fill(minLen, Integer.MAX_VALUE);

        int left = 0;
        int sum = 0;
        int ans = Integer.MAX_VALUE;
        int currentMinLen = Integer.MAX_VALUE;

        for (int right = 0; right < n; right++) {
            sum += arr[right];

            // Contract window if sum exceeds target
            while (sum > target) {
                sum -= arr[left];
                left++;
            }

            // Valid subarray found
            if (sum == target) {
                int currentLen = right - left + 1;

                // Combine with best valid non-overlapping subarray ending before 'left'
                if (left > 0 && minLen[left - 1] != Integer.MAX_VALUE) {
                    ans = Math.min(ans, minLen[left - 1] + currentLen);
                }

                currentMinLen = Math.min(currentMinLen, currentLen);
            }

            minLen[right] = currentMinLen;
        }

        return ans == Integer.MAX_VALUE ? -1 : ans;
    }
}
