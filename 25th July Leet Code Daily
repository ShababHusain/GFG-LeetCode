class Solution {
    public int maxProduct(int n) {
        int first = -1;  // largest digit
        int second = -1; // second largest digit
        
        while (n > 0) {
            int digit = n % 10;
            n /= 10;
            
            if (digit > first) {
                second = first;
                first = digit;
            } else if (digit > second) {
                second = digit;
            }
        }
        
        return first * second;
    }
}
