class Solution {
    public int subsequenceSum(String s) {
        long MOD = 1_000_000_007;
        long totalSum = 0;
        int n = s.length();
        
        for (int i = 0; i < n; i++) {
            totalSum = (totalSum + (s.charAt(i) - '0')) % MOD;
        }
        
        long powerOfTwo = power(2, n - 1, MOD);
        long ans = (totalSum * powerOfTwo) % MOD;
        return (int) ans;
    }
    
    private long power(long base, long exp, long mod) {
        long res = 1;
        base %= mod;
        while (exp > 0) {
            if ((exp & 1) == 1) {
                res = (res * base) % mod;
            }
            base = (base * base) % mod;
            exp >>= 1;
        }
        return res;
    }
}
