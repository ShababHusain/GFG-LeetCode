class Solution {
    public ArrayList<ArrayList<Integer>> levelSort(int[] arr) {
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        int n = arr.length;
        int index = 0;
        int level = 0;

        while (index < n) {
            int count = (int) Math.pow(2, level); // number of nodes at this level
            ArrayList<Integer> levelNodes = new ArrayList<>();

            for (int i = 0; i < count && index < n; i++) {
                levelNodes.add(arr[index++]);
            }

            Collections.sort(levelNodes); // sort nodes at this level
            result.add(levelNodes);
            level++;
        }

        return result;
    }
}
