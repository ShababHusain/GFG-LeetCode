class Solution {
    public ArrayList<ArrayList<Integer>> socialNetwork(int[] arr) {
        int n = arr.length + 1;
        int[][] dist = new int[n + 1][n + 1];
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();

        for (int i = 2; i <= n; i++) {
            int parent = arr[i - 2];

            // Direct link to parent
            dist[i][parent] = 1;

            // Inherit all reachabilities from parent
            for (int j = 1; j < parent; j++) {
                if (dist[parent][j] > 0) {
                    dist[i][j] = dist[parent][j] + 1;
                }
            }

            // Collect reachable pairs [i, j, k] in increasing order of j
            for (int j = 1; j < i; j++) {
                if (dist[i][j] > 0) {
                    ArrayList<Integer> tuple = new ArrayList<>();
                    tuple.add(i);
                    tuple.add(j);
                    tuple.add(dist[i][j]);
                    result.add(tuple);
                }
            }
        }

        return result;
    }
}
