class Solution {
    public int numOfSubarrays(int[] arr) {
        long mod = 1_000_000_007;
        long oddCount = 0;
        long evenCount = 1; // Prefix sum 0 is even
        long currentSum = 0;
        long ans = 0;
        
        for (int num : arr) {
            currentSum += num;
            if (currentSum % 2 == 1) {
                ans = (ans + evenCount) % mod;
                oddCount++;
            } else {
                ans = (ans + oddCount) % mod;
                evenCount++;
            }
        }
        
        return (int) ans;
    }
}
