class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        long[] squares = new long[n];
        
        for (int i = 0; i < n; i++) {
            squares[i] = (long) nums[i] * nums[i];
        }
        
        Arrays.sort(squares);
        
        long score = 0;
        int oddCount = n / 2; // Number of negative terms
        
        // Subtract the smallest squares
        for (int i = 0; i < oddCount; i++) {
            score -= squares[i];
        }
        
        // Add the largest squares
        for (int i = oddCount; i < n; i++) {
            score += squares[i];
        }
        
        return score;
    }
}
