class Solution {
    public int maxSubsetXOR(int[] arr) {
        int n = arr.length;
        int index = 0;

        // Process bits from MSB (31) down to LSB (0)
        for (int bit = 31; bit >= 0; bit--) {
            int maxInd = -1;
            for (int i = index; i < n; i++) {
                if (((arr[i] >> bit) & 1) == 1) {
                    maxInd = i;
                    break;
                }
            }

            // If no element has this bit set, skip
            if (maxInd == -1) continue;

            // Swap chosen element to current index
            int temp = arr[index];
            arr[index] = arr[maxInd];
            arr[maxInd] = temp;

            // Reduce other elements having this bit set
            for (int i = 0; i < n; i++) {
                if (i != index && ((arr[i] >> bit) & 1) == 1) {
                    arr[i] ^= arr[index];
                }
            }
            index++;
        }

        // Compute maximum XOR from basis
        int result = 0;
        for (int i = 0; i < n; i++) {
            result = Math.max(result, result ^ arr[i]);
        }
        return result;
    }
}
