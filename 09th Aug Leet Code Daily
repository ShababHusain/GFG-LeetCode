class Solution {
    public int stoneGameII(int[] piles) {
        int n = piles.length;
        int[] suffixSum = new int[n + 1];
        
        // Build suffix sums: suffixSum[i] = total stones from i to end
        for (int i = n - 1; i >= 0; i--) {
            suffixSum[i] = suffixSum[i + 1] + piles[i];
        }
        
        // Memoization table
        Integer[][] memo = new Integer[n][n + 1];
        
        return dp(0, 1, piles, suffixSum, memo);
    }
    
    private int dp(int i, int M, int[] piles, int[] suffixSum, Integer[][] memo) {
        int n = piles.length;
        if (i >= n) return 0;
        if (2 * M >= n - i) return suffixSum[i]; // Alice can take all remaining piles
        
        if (memo[i][M] != null) return memo[i][M];
        
        int best = 0;
        // Try taking X piles, where 1 <= X <= 2M
        for (int X = 1; X <= 2 * M; X++) {
            // Alice takes suffixSum[i] - dp(i+X, max(M,X), ...)
            best = Math.max(best, suffixSum[i] - dp(i + X, Math.max(M, X), piles, suffixSum, memo));
        }
        
        memo[i][M] = best;
        return best;
    }
}
