class Solution {
    public int minOperations(String s) {
        int n = s.length();
        boolean isSorted = true;
        char mn = s.charAt(0);
        char mx = s.charAt(0);
        
        for (int i = 1; i < n; i++) {
            if (s.charAt(i) < s.charAt(i - 1)) {
                isSorted = false;
            }
            mn = (char) Math.min(mn, s.charAt(i));
            mx = (char) Math.max(mx, s.charAt(i));
        }
        
        // If the string is already sorted
        if (isSorted) {
            return 0;
        }
        
        // A length-2 unsorted string cannot be sorted using proper substrings
        if (n == 2) {
            return -1;
        }
        
        // If the minimum character is at the start or maximum character is at the end
        if (s.charAt(0) == mn || s.charAt(n - 1) == mx) {
            return 1;
        }
        
        // If any interior character is equal to the minimum or maximum, it takes 2 operations
        for (int i = 1; i < n - 1; i++) {
            if (s.charAt(i) == mn || s.charAt(i) == mx) {
                return 2;
            }
        }
        
        // Otherwise, it requires 3 operations
        return 3;
    }
}
